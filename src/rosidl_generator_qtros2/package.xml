<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosidl_generator_qtros2</name>
  <version>0.1.0</version>
  <description>Qt/QML code generator for ROS 2 interfaces</description>
  <maintainer email="dev@qtros2.org">QtROS2 Team</maintainer>
  <license>GPL-3.0-only</license>
  <license>LicenseRef-Qt-Commercial</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Generator dependencies -->
  <depend>rosidl_cmake</depend>
  <depend>rosidl_parser</depend>
  <depend>rosidl_pycommon</depend>
  <depend>rosidl_runtime_cpp</depend>

  <!-- Runtime dependency for generated code -->
  <depend>qtros2_core</depend>

  <!-- Python for templates -->
  <exec_depend>python3-empy</exec_depend>

  <!-- This package is a member of rosidl_generator_packages (for code generation) -->
  <member_of_group>rosidl_generator_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
