<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qtros2_core</name>
  <version>0.1.0</version>
  <description>QtROS2 Core - QML module for ROS2 integration with Qt Quick</description>
  <maintainer email="dev@qtros2.org">QtROS2 Team</maintainer>
  <license>GPL-3.0-only</license>
  <license>LicenseRef-Qt-Commercial</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rosidl_runtime_cpp</depend>

  <!-- Qt6 dependencies (system) -->
  <depend>qt6-base-dev</depend>
  <depend>qt6-declarative-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
