include($QT_INSTALL_DOCS/global/qt-module-defaults.qdocconf)

project = QtRos2
description = Qt ROS2 Bridge Reference Documentation
version = $QT_VERSION

qhp.projects = QtRos2

qhp.QtRos2.file = qtros2.qhp
qhp.QtRos2.namespace = org.qt-project.qtros2.$QT_VERSION_TAG
qhp.QtRos2.virtualFolder = qtros2
qhp.QtRos2.indexTitle = Qt ROS2
qhp.QtRos2.indexRoot =

qhp.QtRos2.subprojects = qmltypes examples
qhp.QtRos2.subprojects.qmltypes.title = QML Types
qhp.QtRos2.subprojects.qmltypes.indexTitle = Qt ROS2 QML Types
qhp.QtRos2.subprojects.qmltypes.selectors = qmlclass
qhp.QtRos2.subprojects.qmltypes.sortPages = true
qhp.QtRos2.subprojects.examples.title = Examples
qhp.QtRos2.subprojects.examples.indexTitle = Qt ROS2 Examples
qhp.QtRos2.subprojects.examples.selectors = example
qhp.QtRos2.subprojects.examples.sortPages = true

depends = qtcore qtdoc qtqml qtquick3d qtquick3dphysics

moduleheader = QtRos2Core

headerdirs += ../
sourcedirs += ../
imagedirs += images
imagedirs += ../../examples
exampledirs += ../../examples

navigation.landingpage = "Qt ROS2"
navigation.qmltypespage = "Qt ROS2 QML Types"

tagfile = qtros2.tags

